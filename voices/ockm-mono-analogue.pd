#N canvas 160 160 900 620 12;
#X text 20 10 Analogue engine: saw to square with a sub \, through a resonant 24 dB low-pass. The workhorse house and techno bass (the default);
#X obj 30 50 inlet;
#X obj 30 80 spigot 1;
#X obj 30 120 ockm-mono-core;
#X obj 200 50 inlet;
#X obj 310 50 inlet;
#X obj 420 50 inlet;
#X obj 530 50 inlet;
#X obj 700 50 r ockm-\$1-engine;
#X obj 700 80 == 5;
#X obj 700 110 t f f;
#X obj 700 170 switch~;
#X obj 760 140 sel 0;
#X msg 760 170 off;
#X obj 650 50 expr 20*pow(100\,\$f1);
#X obj 30 560 outlet~;
#X obj 30 200 mtof~;
#X obj 30 230 ockm-blsaw;
#X obj 150 230 ockm-blsquare;
#X obj 270 200 *~ 0.5;
#X obj 270 230 ockm-blsquare;
#X obj 30 270 expr~ \$v1*(1-\$f4) - \$v2*\$f4*0.8 - \$v3*0.3;
#X obj 450 270 expr~ min(12000\, max(40\, \$f2*(1 + \$v1*\$f3)));
#X obj 30 310 vcf~ 1.2;
#X obj 30 340 vcf~ 0.9;
#X obj 30 375 expr~ tanh(4*\$v1)/tanh(4);
#X obj 30 405 *~;
#X obj 30 435 *~ 0.65;
#X obj 200 140 expr 60*pow(2\,7.5*\$f1);
#X obj 420 140 * 10;
#X text 200 110 k1 cutoff / k2 saw to square / k3 filter envelope (how far each note opens it) / k4 decay. With a square sub an octave down.;
#X text 200 25 k1 / k2 / k3 / k4 (0 to 1) \, k4 is always decay;
