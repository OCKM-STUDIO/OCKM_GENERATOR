#X obj 450 270 expr~ min(18000\, max(30\, \$f2*(1 + \$v1*\$f3)));
#X obj 30 310 fexpr~ 2*((1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+0.9091)))*\$y1[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+0.9091))))*(\$x1[0]-\$y2[-1])) - \$y1[-1] \; 2*(\$y2[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+0.9091))))*\$y1[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+0.9091)))))*(\$x1[0]-\$y2[-1])) - \$y2[-1] \; (\$y2[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+0.9091))))*\$y1[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+0.9091)))))*(\$x1[0]-\$y2[-1]));
#X obj 30 340 fexpr~ 2*((1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+1.25)))*\$y1[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+1.25))))*(\$x1[0]-\$y2[-1])) - \$y1[-1] \; 2*(\$y2[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+1.25))))*\$y1[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+1.25)))))*(\$x1[0]-\$y2[-1])) - \$y2[-1] \; (\$y2[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+1.25))))*\$y1[-1] + (tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(1/(1+tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))*(tan(3.14159265*min(\$x2[0]\, 0.45*\$f3)/max(\$f3\, 1))+1.25)))))*(\$x1[0]-\$y2[-1]));
