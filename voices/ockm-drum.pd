#N canvas 180 180 1100 320 12;
#X text 20 10 Drum slot: a drum lab sound (picked by ockm-<slot>-sound 0-7 and \, for perc \, ockm-<slot>-synth) \, or a sample when ockm-<slot>-sample is 1 or more. Only the one in use runs. ockm-<slot>-audition plays it once.;
#X obj 30 50 inlet;
#X obj 130 50 r ockm-\$1-audition;
#X obj 300 50 ockm-labdrum \$1;
#X obj 500 20 r ockm-\$1-labact;
#X obj 500 45 s \$0-act;
#N canvas 0 0 420 160 kick 0;
#X obj 20 110 outlet~;
#X obj 20 80 ockm-lab-kick ockm-\$1-kick;
#X obj 200 20 r \$0-act;
#X obj 200 50 == 0;
#X obj 200 80 t f f;
#X obj 200 110 switch~;
#X connect 1 0 0 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 1 5 0;
#X restore 30 100 pd kick;
#N canvas 0 0 420 160 snare 0;
#X obj 20 110 outlet~;
#X obj 20 80 ockm-lab-snare ockm-\$1-snare;
