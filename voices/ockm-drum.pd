#N canvas 180 180 900 300 12;
#X text 20 10 Drum slot: plays one of the 8 drum sounds (ockm-<slot>-sound 0-7) \, or a sample when ockm-<slot>-sample is 1 or more. Only the one in use runs. ockm-<slot>-audition plays it once.;
#X obj 30 50 inlet;
#X obj 130 50 r ockm-\$1-audition;
#X obj 500 20 r ockm-\$1-sound;
#X obj 650 20 r ockm-\$1-sample;
#X obj 650 45 t b f;
#X obj 500 70 expr if(\$f2>0 \, 8 \, \$f1);
#X obj 500 95 s \$0-act;
