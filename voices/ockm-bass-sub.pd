#N canvas 160 160 900 620 12;
#X text 20 10 Sub engine: a driven sine wave with a pitch drop. Deep and clean;
#X obj 30 50 inlet;
#X obj 30 80 spigot 1;
#X obj 30 120 ockm-bass-core;
#X obj 200 50 inlet;
#X obj 310 50 inlet;
#X obj 420 50 inlet;
#X obj 530 50 inlet;
#X obj 700 50 r ockm-bass-engine;
#X obj 700 80 == 1;
#X obj 700 110 t f f;
#X obj 700 170 switch~;
#X obj 760 140 sel 0;
#X msg 760 170 off;
#X obj 650 50 expr 20*pow(100\,\$f1);
#X obj 30 560 outlet~;
#X obj 300 200 *~ 12;
#X obj 30 230 +~;
#X obj 30 260 mtof~;
#X obj 30 290 osc~;
#X obj 30 320 *~ 1;
