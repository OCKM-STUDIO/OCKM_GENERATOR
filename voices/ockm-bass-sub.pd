#X obj 30 410 *~;
#X obj 30 440 *~ 0.9;
#X obj 200 140 expr 60*pow(2\,7*\$f1);
#X obj 310 140 expr 1+6*\$f1;
#X obj 420 140 * 24;
#X text 200 110 k1 tone / k2 drive / k3 pitch drop on each note;
#X text 200 25 k1 / k2 / k3 / k4 (0 to 1) \, k4 is always decay;
