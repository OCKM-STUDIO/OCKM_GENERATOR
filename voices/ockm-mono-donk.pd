#X msg 760 170 off;
#X obj 650 50 expr 120*pow(12\,\$f1);
#X obj 30 560 outlet~;
#X obj 300 200 expr~ pow(min(1\, max(0\, \$v1))\, 12)*\$f2;
#X obj 30 230 +~;
