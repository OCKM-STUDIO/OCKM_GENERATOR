#N canvas 160 160 900 620 12;
#X text 20 10 Donk engine: a hollow tone that bounces down onto each note and rings out. Bassline house \, garage \, M1 organ bass;
#X obj 30 50 inlet;
#X obj 30 80 spigot 1;
#X obj 30 120 ockm-mono-core;
#X obj 200 50 inlet;
#X obj 310 50 inlet;
#X obj 420 50 inlet;
#X obj 530 50 inlet;
#X obj 700 50 r ockm-\$1-engine;
