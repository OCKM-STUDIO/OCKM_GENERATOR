#X obj 390 290 ockm-blsquare;
#X obj 390 320 lop~ 1200;
#X obj 30 350 expr~ \$v1 + \$f5*(0.5*\$v2 + 0.3*\$v3) + \$f6*0.7*\$v4;
#X obj 30 380 expr~ tanh(1.4*\$v1)/tanh(1.4);
#X obj 200 380 expr~ pow(min(1\, max(0\, \$v1))\, 1.3);
#X obj 30 410 *~;
#X obj 30 440 *~ 0.8;
#X obj 310 140 * 14;
#X text 200 110 k1 brightness (organ harmonics) / k2 bounce (pitch drop onto the note) / k3 hollow (woodier) / k4 decay. Rings out on its own.;
