#X obj 300 70 t f f;
#X obj 420 70 s ockm-filter-now;
#X obj 520 20 r ockm-rise-now;
#X obj 520 40 pack f 100;
#X obj 520 60 line 0 10;
#X obj 520 80 t b f;
#X obj 300 75 expr if(\$f2>0.001 \, max(\$f1 \, \$f2) \, \$f1);
#X obj 300 80 expr if(\$f1>0 \, 20*pow(2\,\$f1*9.6) \, 10) \; if(\$f1<0 \, 20000*pow(2\,\$f1*9.6) \, 20000);
#X obj 300 200 r ockm-drive;
#X obj 300 230 expr 1+\$f1*9;
#X obj 30 230 expr~ if(\$f2>1.001 \, tanh(\$v1*\$f2)/sqrt(\$f2) \, \$v1);
#X obj 200 330 delwrite~ \$0-dly 4000;
#X obj 200 290 delread~ \$0-dly 363;
#X obj 200 360 *~ 0.4;
#X obj 200 400 *~ 0;
#X obj 500 250 r ockm-stepms;
#X obj 620 250 r ockm-delay-steps;
#X obj 500 280 * 3;
#X obj 500 330 r ockm-delay-fb;
#X obj 500 380 r ockm-delay-mix;
#X obj 620 280 t b f;
#X obj 500 220 f 121;
#X obj 30 440 +~;
#X obj 30 470 expr~ if(abs(\$v1)<0.8 \, \$v1 \, (0.8+0.2*tanh((abs(\$v1)-0.8)/0.2))*(\$v1/abs(\$v1)));
#X obj 30 510 outlet~;
#X text 500 410 delay time = step length x delay steps (3 = dotted 8th);
