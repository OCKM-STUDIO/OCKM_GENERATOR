#N canvas 140 140 900 560 12;
#X text 20 10 Master effects: reverb and delay returns \, DJ filter \, drive \, tempo-synced delay \, then a soft limiter.;
#X obj 30 30 inlet~;
#X obj 150 30 catch~ ockm-revbus;
#X obj 150 55 ockm-verb;
#X obj 150 75 *~ 0.3;
#X obj 300 30 r ockm-verb-mix;
#X obj 30 70 +~;
#X obj 30 90 +~;
#X obj 200 300 catch~ ockm-dlybus;
#X obj 30 90 hip~ 10;
#X obj 30 115 hip~ 10;
#X obj 30 140 lop~ 20000;
#X obj 30 165 lop~ 20000;
#X obj 300 50 r ockm-filter;
#X obj 300 80 expr if(\$f1>0 \, 20*pow(2\,\$f1*9.6) \, 10) \; if(\$f1<0 \, 20000*pow(2\,\$f1*9.6) \, 20000);
#X obj 300 200 r ockm-drive;
#X obj 300 230 expr 1+\$f1*9;
#X obj 30 230 expr~ if(\$f2>1.001 \, tanh(\$v1*\$f2)/sqrt(\$f2) \, \$v1);
#X obj 200 330 delwrite~ \$0-dly 4000;
#X obj 200 290 delread~ \$0-dly 363;
#X obj 200 360 *~ 0.4;
#X obj 200 400 *~ 0;
#X obj 500 250 r ockm-stepms;
#X obj 620 250 r ockm-delay-steps;
#X obj 500 280 * 3;
#X obj 500 330 r ockm-delay-fb;
#X obj 500 380 r ockm-delay-mix;
#X obj 620 280 t b f;
#X obj 500 220 f 121;
#X obj 30 440 +~;
#X obj 30 470 expr~ if(abs(\$v1)<0.8 \, \$v1 \, (0.8+0.2*tanh((abs(\$v1)-0.8)/0.2))*(\$v1/abs(\$v1)));
#X obj 30 510 outlet~;
#X text 500 410 delay time = step length x delay steps (3 = dotted 8th);
