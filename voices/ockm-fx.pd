#N canvas 140 140 900 560 12;
#X text 20 10 Master effects: reverb and delay returns \, DJ filter \, drive \, tempo-synced delay \, then a soft limiter.;
#X obj 30 30 inlet~;
#X obj 150 30 catch~ ockm-revbus;
#X obj 150 55 ockm-verb;
#X obj 150 75 *~ 0.3;
#X obj 300 30 r ockm-verb-mix;
#X obj 30 70 +~;
#X obj 30 90 +~;
#X obj 200 300 catch~ ockm-dlybus;
#X obj 30 100 +~;
#X obj 30 90 hip~ 10;
#X obj 30 115 hip~ 10;
#X obj 30 140 lop~ 20000;
#X obj 30 165 lop~ 20000;
