#N canvas 150 150 1300 820 12;
#X text 20 10 Sample player for one drum slot. ockm-<slot>-sample n loads the nth file from samples/<sound folder>. Tune = playback speed \, decay cuts the tail \, level scales.;
#X obj 30 50 inlet;
#X obj 600 50 loadbang;
#X obj 600 75 t b b;
#X msg 700 100 dir;
#X obj 700 125 pdcontrol;
#X obj 700 150 list append ../samples;
#X obj 700 175 file join;
#X obj 600 300 list prepend;
#X obj 700 200 list;
#X obj 600 150 r ockm-\$1-sound;
#X obj 600 200 f;
#X obj 600 175 t b f;
#X obj 800 150 r ockm-\$1-sample;
#X obj 800 175 t b f f;
#X obj 900 230 f;
#X obj 900 200 delay 2;
#X obj 900 225 t b b;
#X msg 1000 250 0;
#X obj 900 255 moses 1;
#X obj 960 280 t b;
