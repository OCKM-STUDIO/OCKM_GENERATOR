#X obj 660 530 route wav WAV aif aiff AIF AIFF Wav Aif;
#X obj 660 555 t b;
#X obj 600 600 t b s;
#X obj 600 650 symbol;
#X obj 600 680 list append \$0-smp;
#X obj 600 705 list prepend read -resize;
#X obj 600 730 list trim;
#X obj 600 755 soundfiler;
#X obj 700 780 unpack f;
#X obj 900 700 table \$0-smp;
#X obj 30 120 expr \$f2*(1-0.4*\$f7)/max(\$f3\,1)*1000/pow(2\,\$f4/12) \; \$f1*\$f6*0.8 \; \$f2*(1-0.4*\$f7)/max(\$f3\,1)*1000/pow(2\,\$f4/12)*min(\$f5\,100)/100 \; \$f2 \; 1+\$f2*0.4*\$f7;
