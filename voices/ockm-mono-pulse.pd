#X obj 450 360 clip~ 30 12000;
#X obj 200 140 expr 50*pow(2\,8*\$f1);
#X msg 700 360 1.36;
#X obj 700 335 loadbang;
#X obj 30 400 bob~;
#X obj 30 430 *~ 1.5;
#X obj 560 140 expr min(1\, max(0\, (\$f1-0.6)*4));
#X obj 200 470 expr~ max(\$v1\, \$f3*pow(min(1\, max(0\, \$v2))\, 1.5));
#X obj 30 500 *~;
#X obj 30 530 *~ 0.75;
