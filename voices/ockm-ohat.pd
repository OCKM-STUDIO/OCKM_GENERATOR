#N canvas 200 200 900 320 12;
#X text 20 10 Open hat: high-passed noise \, longer tail.;
#X obj 30 50 inlet;
#X obj 30 80 * 1;
#X obj 30 110 * 0.25;
#X obj 30 140 pack f 300;
#X msg 30 170 \$1 \, 0 \$2;
#X obj 30 200 vline~;
#X obj 250 80 noise~;
#X obj 250 120 hip~ 6000;
#X obj 250 230 *~;
#X obj 250 270 outlet~;
#X obj 450 50 r ockm-\$1-tune;
#X obj 620 50 r ockm-\$1-decay;
#X obj 800 50 r ockm-\$1-level;
#X obj 450 80 expr 6000*pow(2\,\$f1/12);
#X obj 620 80 * 3.0;
#X text 450 120 tune (semitones) / decay (% \, 100 = normal) / level (0-1);
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 1 0 2 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 6 0 9 1;
#X connect 9 0 10 0;
#X connect 11 0 14 0;
#X connect 14 0 8 1;
#X connect 12 0 15 0;
