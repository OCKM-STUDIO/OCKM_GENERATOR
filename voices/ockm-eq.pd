#N canvas 120 120 1000 560 12;
#X text 20 10 Track EQ: low cut \, then low shelf (100 Hz) \, mid bell (ockm-<t>-eqmidf) and high shelf (8 kHz) \, each -12 to +12 dB. Flat when all are 0.;
#X obj 30 300 inlet~;
#X obj 30 520 outlet~;
#X obj 30 20 loadbang;
#X obj 30 40 t b b;
#X obj 120 40 samplerate~;
#X obj 120 60 v ockm_sr;
#X obj 30 330 r ockm-\$1-lowcut;
#X obj 30 360 hip~ 20;
#X obj 30 385 hip~ 20;
#X obj 250 60 r ockm-\$1-eqlow;
#X obj 250 110 pack f 100;
#X obj 250 140 expr pow(10\,\$f1/40) \; cos(6.283185*\$f2/max(ockm_sr\,22050)) \; sin(6.283185*\$f2/max(ockm_sr\,22050));
#X obj 250 170 expr 2*((\$f1-1)+(\$f1+1)*\$f2)/((\$f1+1)+(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711) \; -((\$f1+1)+(\$f1-1)*\$f2-2*sqrt(\$f1)*\$f3*0.70711)/((\$f1+1)+(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711) \; \$f1*((\$f1+1)-(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711)/((\$f1+1)+(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711) \; 2*\$f1*((\$f1-1)-(\$f1+1)*\$f2)/((\$f1+1)+(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711) \; \$f1*((\$f1+1)-(\$f1-1)*\$f2-2*sqrt(\$f1)*\$f3*0.70711)/((\$f1+1)+(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711);
#X obj 250 200 pack f f f f f;
#X obj 250 230 biquad~;
#X obj 500 60 r ockm-\$1-eqmid;
#X obj 500 110 pack f 400;
#X obj 590 60 r ockm-\$1-eqmidf;
#X obj 590 85 t b f;
#X obj 500 140 expr pow(10\,\$f1/40) \; cos(6.283185*\$f2/max(ockm_sr\,22050)) \; sin(6.283185*\$f2/max(ockm_sr\,22050));
#X obj 500 170 expr 2*\$f2/(1+(\$f3/2)/\$f1) \; -(1-(\$f3/2)/\$f1)/(1+(\$f3/2)/\$f1) \; (1+(\$f3/2)*\$f1)/(1+(\$f3/2)/\$f1) \; -2*\$f2/(1+(\$f3/2)/\$f1) \; (1-(\$f3/2)*\$f1)/(1+(\$f3/2)/\$f1);
#X obj 500 200 pack f f f f f;
#X obj 500 230 biquad~;
#X obj 800 60 r ockm-\$1-eqhigh;
#X obj 800 110 pack f 8000;
#X obj 800 140 expr pow(10\,\$f1/40) \; cos(6.283185*\$f2/max(ockm_sr\,22050)) \; sin(6.283185*\$f2/max(ockm_sr\,22050));
#X obj 800 170 expr -2*((\$f1-1)-(\$f1+1)*\$f2)/((\$f1+1)-(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711) \; -((\$f1+1)-(\$f1-1)*\$f2-2*sqrt(\$f1)*\$f3*0.70711)/((\$f1+1)-(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711) \; \$f1*((\$f1+1)+(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711)/((\$f1+1)-(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711) \; -2*\$f1*((\$f1-1)+(\$f1+1)*\$f2)/((\$f1+1)-(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711) \; \$f1*((\$f1+1)+(\$f1-1)*\$f2-2*sqrt(\$f1)*\$f3*0.70711)/((\$f1+1)-(\$f1-1)*\$f2+2*sqrt(\$f1)*\$f3*0.70711);
#X obj 800 200 pack f f f f f;
#X obj 800 230 biquad~;
#N canvas 0 0 900 340 spectrum 0;
