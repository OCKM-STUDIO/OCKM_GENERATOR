#N canvas 160 160 900 620 12;
#X text 20 10 House engine: clean square plus a sub sine through a warm filter with a short pluck. Deep house and garage;
#X obj 30 50 inlet;
#X obj 30 80 spigot 1;
#X obj 30 120 ockm-mono-core;
