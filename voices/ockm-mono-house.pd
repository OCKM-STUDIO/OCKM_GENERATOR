#X msg 600 300 0.4;
#X obj 600 270 loadbang;
#X obj 30 370 +~;
#X obj 30 400 *~;
#X obj 30 430 *~ 0.9;
#X obj 200 140 expr 60*pow(2\,6*\$f1);
#X obj 310 140 * 0.8;
#X obj 420 140 * 4000;
#X text 200 110 k1 tone / k2 body (sub sine) / k3 pluck (filter snap on each note);
#X text 200 25 k1 / k2 / k3 / k4 (0 to 1) \, k4 is always decay;
