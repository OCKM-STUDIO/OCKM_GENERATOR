#N canvas 140 140 900 340 12;
#X text 20 10 Lead synth: its own engines \, one plays at a time (ockm-lead-engine: 2 dx 3 sync 4 mini 5 supersaw 6 raw). Glides on slide steps and adds vibrato to held notes.;
#X obj 30 50 inlet;
#X obj 200 50 r ockm-\$1-k1-m;
#X obj 330 50 r ockm-\$1-k2-m;
#X obj 460 50 r ockm-\$1-k3-m;
#X obj 590 50 r ockm-\$1-k4-m;
#X obj 30 130 ockm-lead-dx \$1;
#X obj 160 130 ockm-lead-sync \$1;
#X obj 290 130 ockm-lead-mini \$1;
#X obj 420 130 ockm-lead-supersaw \$1;
#X obj 550 130 ockm-lead-raw \$1;
#X obj 30 200 +~;
#X obj 800 50 r ockm-\$1-engine;
#X obj 800 80 min 6;
#X obj 800 110 s ockm-\$1-voice;
#X obj 400 200 r ockm-\$1-drive;
#X obj 400 230 expr 1+60*pow(\$f1\, 1.5);
#X obj 30 260 expr~ if(\$f2>1.001 \, (tanh(\$f2*\$v1)+0.25*tanh(\$f2*\$v1)*tanh(\$f2*\$v1))*0.25/tanh(0.25*\$f2) \, \$v1);
#X obj 30 280 hip~ 20;
#X obj 30 300 outlet~;
