#N canvas 140 140 900 340 12;
#X text 20 10 Lead synth: its own engines \, one plays at a time (ockm-lead-engine: 2 dx 3 sync 4 mini 5 supersaw). Glides on slide steps and adds vibrato to held notes.;
#X obj 30 50 inlet;
#X obj 200 50 r ockm-\$1-k1-m;
#X obj 330 50 r ockm-\$1-k2-m;
#X obj 460 50 r ockm-\$1-k3-m;
#X obj 590 50 r ockm-\$1-k4-m;
#X obj 30 130 ockm-lead-dx \$1;
#X obj 160 130 ockm-lead-sync \$1;
#X obj 290 130 ockm-lead-mini \$1;
#X obj 420 130 ockm-lead-supersaw \$1;
#X obj 30 200 +~;
#X obj 800 50 r ockm-\$1-engine;
#X obj 800 80 min 5;
#X obj 800 110 s ockm-\$1-voice;
#X obj 400 200 r ockm-\$1-drive;
#X obj 400 230 expr 1+\$f1*9;
#X obj 30 260 expr~ if(\$f2>1.001 \, tanh(\$v1*\$f2)/sqrt(\$f2) \, \$v1);
#X obj 30 300 outlet~;
#X connect 1 0 6 0;
#X connect 2 0 6 1;
#X connect 3 0 6 2;
#X connect 4 0 6 3;
#X connect 5 0 6 4;
#X connect 6 0 10 0;
#X connect 1 0 7 0;
#X connect 2 0 7 1;
#X connect 3 0 7 2;
#X connect 4 0 7 3;
#X connect 5 0 7 4;
#X connect 7 0 10 0;
#X connect 1 0 8 0;
#X connect 2 0 8 1;
#X connect 3 0 8 2;
#X connect 4 0 8 3;
#X connect 5 0 8 4;
#X connect 8 0 10 0;
#X connect 1 0 9 0;
#X connect 2 0 9 1;
#X connect 3 0 9 2;
#X connect 4 0 9 3;
#X connect 5 0 9 4;
#X connect 9 0 10 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
#X connect 14 0 15 0;
#X connect 15 0 16 1;
#X connect 10 0 16 0;
#X connect 16 0 17 0;
