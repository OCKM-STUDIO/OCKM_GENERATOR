#X obj 130 290 osc~;
#X obj 130 320 *~ 0;
#X obj 30 335 +~;
#X obj 200 380 expr~ max(\$v1\, pow(min(1\, max(0\, \$v2))\, 1.5));
#X obj 30 410 *~;
#X obj 30 440 *~ 0.9;
#X obj 200 140 expr 60*pow(2\,7*\$f1);
#X obj 310 140 * 0.6;
#X obj 420 140 * 30;
