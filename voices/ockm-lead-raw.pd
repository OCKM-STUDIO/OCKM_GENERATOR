#N canvas 160 160 900 620 12;
#X text 20 10 Raw lead (MS-20 style): triangle or saw into a screaming resonant filter \, driven. Hypnotic techno sequences;
#X obj 30 50 inlet;
#X obj 30 80 spigot 1;
#X obj 30 120 ockm-lead-core;
