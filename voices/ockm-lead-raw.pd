#X obj 450 200 *~ 4500;
#X obj 450 230 +~ 300;
#X obj 450 260 clip~ 30 12000;
#X obj 200 140 expr 45*pow(2\,8*\$f1);
#X obj 30 350 bob~;
#X obj 310 140 expr 0.3+4.1*pow(\$f1\, 1.3);
#X obj 30 380 expr~ tanh(2.8*\$v1)/tanh(2.8);
#X obj 30 410 *~;
#X obj 30 440 *~ 0.8;
#X text 200 110 k1 cutoff / k2 resonance (self-oscillates at the top) / k3 triangle to saw / k4 decay;
#X text 200 25 k1 / k2 / k3 / k4 (0 to 1) \, k4 is always decay;
