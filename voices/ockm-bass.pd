#N canvas 140 140 900 340 12;
#X text 20 10 Bass: six engines \, one plays at a time (ockm-bass-engine 0 to 5). Knobs k1-k4 and drive come in on hooks.;
#X obj 30 50 inlet;
#X obj 200 50 r ockm-bass-k1;
#X obj 330 50 r ockm-bass-k2;
#X obj 460 50 r ockm-bass-k3;
#X obj 590 50 r ockm-bass-k4;
#X obj 30 130 ockm-bass-acid;
#X obj 160 130 ockm-bass-sub;
#X obj 290 130 ockm-bass-fm;
#X obj 420 130 ockm-bass-reese;
#X obj 550 130 ockm-bass-pluck;
#X obj 680 130 ockm-bass-saw;
#X obj 30 200 +~;
#X obj 400 200 r ockm-bass-drive;
#X obj 400 230 expr 1+\$f1*9;
#X obj 30 260 expr~ tanh(\$v1*max(\$f2\,1))/sqrt(max(\$f2\,1));
#X obj 30 300 outlet~;
#X text 400 260 drive: 0 clean \, 1 heavy;
