#N canvas 160 160 900 640 12;
#X text 20 10 Reverb: four damped comb filters in parallel then two all-pass filters (a classic Schroeder/Freeverb-style room). Size sets the tail \, tone darkens it.;
#X obj 30 50 inlet~;
#X obj 500 50 r ockm-verb-size;
#X obj 500 80 expr 0.7+\$f1*0.27;
#X obj 680 50 r ockm-verb-tone;
#X obj 680 80 expr 1500*pow(2\,\$f1*3.5);
#X obj 30 330 +~;
#X obj 30 355 +~;
#X obj 30 380 +~;
#X obj 30 405 *~ 0.25;
#X obj 30 120 +~;
#X obj 30 150 delwrite~ \$0-c0 60;
#X obj 30 180 delread~ \$0-c0 29.7;
#X obj 30 210 lop~ 4000;
#X obj 30 240 *~ 0.84;
#X obj 145 120 +~;
#X obj 145 150 delwrite~ \$0-c1 60;
#X obj 145 180 delread~ \$0-c1 37.1;
#X obj 145 210 lop~ 4000;
#X obj 145 240 *~ 0.84;
#X obj 260 120 +~;
#X obj 260 150 delwrite~ \$0-c2 60;
#X obj 260 180 delread~ \$0-c2 41.1;
#X obj 260 210 lop~ 4000;
#X obj 260 240 *~ 0.84;
#X obj 375 120 +~;
#X obj 375 150 delwrite~ \$0-c3 60;
#X obj 375 180 delread~ \$0-c3 43.7;
#X obj 375 210 lop~ 4000;
#X obj 375 240 *~ 0.84;
#X obj 30 450 +~;
#X obj 30 480 delwrite~ \$0-a0 20;
#X obj 130 450 delread~ \$0-a0 5.0;
#X obj 130 480 *~ 0.5;
#X obj 30 510 *~ -0.5;
#X obj 30 540 +~;
#X obj 260 450 +~;
#X obj 260 480 delwrite~ \$0-a1 20;
#X obj 360 450 delread~ \$0-a1 1.7;
#X obj 360 480 *~ 0.5;
#X obj 260 510 *~ -0.5;
#X obj 260 540 +~;
#X obj 30 600 outlet~;
#X connect 2 0 3 0;
#X connect 4 0 5 0;
#X connect 1 0 10 0;
#X connect 10 0 11 0;
#X connect 12 0 13 0;
#X connect 13 0 14 0;
#X connect 14 0 10 1;
