#N canvas 140 140 900 340 12;
#X text 20 10 Mono synth (bass or lead): six engines \, one plays at a time (ockm-<track>-engine 0 to 5). Knobs k1-k4 and drive come in on hooks.;
#X obj 30 50 inlet;
#X obj 200 50 r ockm-\$1-k1-m;
#X obj 330 50 r ockm-\$1-k2-m;
#X obj 460 50 r ockm-\$1-k3-m;
#X obj 590 50 r ockm-\$1-k4-m;
#X obj 30 130 ockm-mono-acid \$1;
#X obj 160 130 ockm-mono-sub \$1;
#X obj 290 130 ockm-mono-fm \$1;
#X obj 420 130 ockm-mono-reese \$1;
#X obj 550 130 ockm-mono-analogue \$1;
#X obj 680 130 ockm-mono-donk \$1;
#X obj 30 200 +~;
#X obj 400 200 r ockm-\$1-drive;
#X obj 400 230 expr 1+\$f1*9;
#X obj 30 260 expr~ if(\$f2>1.001 \, tanh(\$v1*\$f2)/sqrt(\$f2) \, \$v1);
#X obj 30 300 outlet~;
#X text 400 260 drive: 0 clean \, 1 heavy;
#X connect 1 0 6 0;
#X connect 2 0 6 1;
#X connect 3 0 6 2;
#X connect 4 0 6 3;
#X connect 5 0 6 4;
