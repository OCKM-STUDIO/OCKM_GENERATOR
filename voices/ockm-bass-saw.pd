#N canvas 160 160 900 620 12;
#X text 20 10 Saw engine: a raw sawtooth. No squelch \, just a hard buzzy bass;
#X obj 30 50 inlet;
#X obj 30 80 spigot 1;
#X obj 30 120 ockm-bass-core;
#X obj 200 50 inlet;
#X obj 310 50 inlet;
#X obj 420 50 inlet;
#X obj 530 50 inlet;
#X obj 700 50 r ockm-bass-engine;
#X obj 700 80 == 5;
#X obj 700 110 t f f;
#X obj 700 170 switch~;
#X obj 760 140 sel 0;
#X msg 760 170 off;
#X obj 650 50 expr 20*pow(100\,\$f1);
#X obj 30 560 outlet~;
#X obj 30 200 mtof~;
#X obj 30 240 phasor~;
#X obj 150 210 *~ 1;
#X obj 150 240 phasor~;
#X obj 270 210 *~ 0.5;
#X obj 270 240 phasor~;
#X obj 150 270 *~ 0;
#X obj 270 270 *~ 0;
#X obj 30 300 +~;
#X obj 30 325 +~;
#X obj 30 355 expr~ (\$v1-0.5*(1+\$f2+\$f3))*2/(1+\$f2+\$f3);
#X obj 30 390 lop~ 20000;
#X obj 30 415 lop~ 20000;
#X obj 450 300 *~ 4;
#X obj 450 330 clip~ 0 1;
#X obj 30 450 *~;
#X obj 30 480 *~ 0.6;
#X obj 200 140 expr 60*pow(2\,8.4*\$f1);
#X obj 310 140 expr 1+0.02*\$f1 \; if(\$f1>0 \, 0.7 \, 0);
#X obj 420 170 * 0.8;
#X text 200 110 k1 tone (1 = fully raw) / k2 second saw detune (0 = single saw) / k3 sub saw an octave down / k4 note length. Notes play at full level then stop hard.;
#X text 200 25 k1 / k2 / k3 / k4 (0 to 1) \, k4 is always decay;
