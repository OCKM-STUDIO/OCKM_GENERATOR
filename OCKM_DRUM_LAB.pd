#N canvas 40 40 1180 900 12;
#X declare -path lab -path voices;
#X text 20 10 OCKM DRUM LAB: design claps \, snares and hats \, then render them into the samples folders for OCKM (or the SP-404). Click to play \, drag the sliders \, randomise around what you have.;
#X obj 1240 60 ockm-lab;
#X obj 1240 120 ockm-lab-clap;
#X obj 1390 120 ockm-lab-snare;
#X obj 1540 120 ockm-lab-hat;
#X obj 1660 90 r lab-kick;
#X obj 1660 120 ockm-kick labkick;
#X obj 1240 150 +~;
#X obj 1240 175 +~;
#X obj 1240 200 +~;
#X obj 1240 230 *~ 0.8;
#X obj 1240 260 dac~;
#X obj 1420 200 writesf~ 1;
#X obj 1420 170 r lab-rec;
#X obj 1660 150 *~ 0.7;
#X obj 1660 200 loadbang;
#X msg 1660 225 \; pd dsp 1;
#X text 20 50 CLAP;
#X obj 20 80 bng 30 250 50 0 lab-clap-play empty play 36 15 0 12 #fcfcfc #000000 #000000;
#X obj 140 80 tgl 30 0 lab-clap-loop empty loop_with_kick 36 15 0 12 #fcfcfc #000000 #000000 0 1;
#X text 20 128 randomise:;
#X obj 120 122 bng 30 250 50 0 lab-clap-rand-small empty small 36 15 0 12 #fcfcfc #000000 #000000;
#X obj 210 122 bng 30 250 50 0 lab-clap-rand-medium empty medium 36 15 0 12 #fcfcfc #000000 #000000;
#X obj 300 122 bng 30 250 50 0 lab-clap-rand-wild empty wild 36 15 0 12 #fcfcfc #000000 #000000;
