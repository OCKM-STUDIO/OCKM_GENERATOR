#N canvas 20 20 1220 1000 12;
#X declare -path lab -path voices;
#X text 20 10 OCKM DRUM LAB: design a kit \, then render it into the samples folders for OCKM (or the SP-404). Click to play \, drag the sliders \, randomise around what you have. Sets (hats \, toms \, congas) render as matching files.;
#X obj 1240 60 ockm-lab;
#X obj 1240 120 ockm-lab-clap;
#X obj 1370 120 ockm-lab-snare;
#X obj 1500 120 ockm-lab-hat;
#X obj 1630 120 ockm-lab-kick;
