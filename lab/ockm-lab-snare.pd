#N canvas 200 200 900 640 12;
#X text 20 10 Lab snare: two tones with a pitch drop (\$1-freq \, \$1-body) \, band-passed noise wires (\$1-wenv) \, a click (\$1-cenv) \, then drive.;
#X obj 30 50 r \$1-freq;
#X obj 30 75 vline~;
#X obj 30 110 osc~;
#X obj 200 75 r \$1-ratio;
#X obj 200 110 *~ 1.6;
#X obj 200 140 osc~;
#X obj 200 170 *~ 0.6;
#X obj 30 200 +~;
#X obj 700 50 r \$1-body;
#X obj 700 75 vline~;
#X obj 700 100 *~;
#X obj 30 230 *~;
#X obj 30 280 noise~;
#X obj 30 310 ockm-lab-bp \$1-wires \$1-wwidth;
#X obj 700 200 r \$1-wenv;
#X obj 700 225 vline~;
#X obj 700 250 *~;
#X obj 30 350 *~;
#X obj 300 310 hip~ 3000;
#X obj 700 350 r \$1-cenv;
#X obj 700 375 vline~;
#X obj 700 400 *~;
#X obj 300 350 *~;
#X obj 450 330 r \$1-click;
#X obj 300 380 *~ 0.4;
#X obj 500 200 r \$1-mix;
#X obj 500 225 t f f;
#X obj 500 250 expr (1-\$f1)*0.5;
#X obj 30 260 *~ 0.25;
#X obj 30 380 *~ 0.55;
#X obj 30 420 +~;
#X obj 30 450 +~;
#X obj 30 490 *~ 1.0;
#X obj 180 490 r \$1-drive;
#X obj 180 515 expr 1+\$f1*4;
#X obj 30 540 expr~ tanh(\$v1*\$f2)/tanh(\$f2);
#X obj 30 570 *~ 0.8;
#X obj 180 545 r \$1-level;
#X obj 180 575 r \$1-vel;
#X msg 180 600 \$1 1;
#X obj 180 625 line~;
#X obj 30 600 *~;
