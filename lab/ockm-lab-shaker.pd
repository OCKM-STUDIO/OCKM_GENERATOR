#N canvas 200 200 900 440 12;
#X text 20 10 Lab shaker: band-passed noise with an attack and a decay (\$1-env) \, low cut \, and grit: crackle from the loudest grains.;
#X obj 30 40 noise~;
#X obj 30 70 ockm-lab-bp \$1-tone \$1-focus;
#X obj 300 80 r \$1-lowcut;
#X obj 30 110 hip~ 3000;
#X obj 30 140 hip~ 3000;
#X obj 300 140 expr~ (\$v1>0.93)*2-(\$v1<-0.93)*2;
#X obj 450 140 r \$1-grit;
#X obj 300 170 *~ 0;
#X obj 30 200 +~;
#X obj 600 40 r \$1-env;
#X obj 600 65 vline~;
#X obj 600 90 *~;
#X obj 30 240 *~;
