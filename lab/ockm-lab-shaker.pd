#X obj 180 305 expr 1+\$f1*4;
#X obj 30 330 expr~ tanh(\$v1*\$f2)/tanh(\$f2);
#X obj 30 360 *~ 0.8;
#X obj 180 335 r \$1-level;
#X obj 30 390 outlet~;
#X obj 330 280 loadbang;
