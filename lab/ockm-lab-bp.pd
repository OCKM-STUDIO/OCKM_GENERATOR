#X obj 200 120 expr 2*cos((6.2831853*\$f1/(if(\$f3>1 \, \$f3 \, 48000))))/(1+(sin((6.2831853*\$f1/(if(\$f3>1 \, \$f3 \, 48000))))/(2*(max(\$f2 \, 0.1))))) \; -(1-(sin((6.2831853*\$f1/(if(\$f3>1 \, \$f3 \, 48000))))/(2*(max(\$f2 \, 0.1)))))/(1+(sin((6.2831853*\$f1/(if(\$f3>1 \, \$f3 \, 48000))))/(2*(max(\$f2 \, 0.1))))) \; (sin((6.2831853*\$f1/(if(\$f3>1 \, \$f3 \, 48000))))/(2*(max(\$f2 \, 0.1))))/(1+(sin((6.2831853*\$f1/(if(\$f3>1 \, \$f3 \, 48000))))/(2*(max(\$f2 \, 0.1))))) \; 0 \; -(sin((6.2831853*\$f1/(if(\$f3>1 \, \$f3 \, 48000))))/(2*(max(\$f2 \, 0.1))))/(1+(sin((6.2831853*\$f1/(if(\$f3>1 \, \$f3 \, 48000))))/(2*(max(\$f2 \, 0.1)))));
#X obj 200 160 pack f f f f f;
