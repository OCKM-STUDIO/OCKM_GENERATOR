#N canvas 120 120 1100 1020 12;
#X text 20 10 Mono generator: builds a bass or lead line from a rhythm preset + a note pattern + the shared key. Args: track \, octave offset \, default rhythm \, default notes.;
#X obj 700 60 array define \$0-r 16;
#X obj 830 60 array define \$0-n 16;
#X obj 960 60 array define \$0-s 7;
#X obj 20 330 t b b b b b;
#X obj 20 170 r ockm-\$1-rhythm;
#X obj 20 200 t b f;
#X obj 20 290 f \$3;
#X obj 190 170 r ockm-\$1-notes;
#X obj 190 200 t b f;
#X obj 190 290 f \$4;
#X obj 360 170 r ockm-root;
#X obj 360 200 t b f;
#X obj 360 290 f 9;
#X obj 530 170 r ockm-scale;
#X obj 530 200 t b f;
#X obj 530 290 f 0;
#X obj 720 170 r ockm-\$1-gen;
#X obj 560 380 text get ockm-presets-scale;
#X obj 560 410 list split 1;
#X obj 560 440 array set \$0-s;
#X obj 360 380 text get ockm-presets-notes;
#X obj 360 410 list split 1;
#X obj 360 440 t l l;
#X obj 420 470 list length;
#X obj 360 500 array set \$0-n;
#X obj 170 380 text get ockm-presets-rhythm;
#X obj 170 410 list split 1;
#X obj 170 440 array set \$0-r;
#X obj 20 410 expr if(36+\$f1>40 \, 24+\$f1 \, 36+\$f1);
#X obj 20 440 + \$2;
#X obj 20 560 t b b;
#X msg 120 590 0;
#X obj 20 590 f 16;
#X obj 80 560 r ockm-len;
#X obj 20 620 until;
#X obj 20 650 f;
#X obj 70 650 + 1;
#X obj 400 760 f;
#X obj 450 760 + 1;
#X obj 20 680 t f f;
#X obj 200 900 tabwrite ockm-pat-\$1-note;
#X obj 370 900 tabwrite ockm-pat-\$1-on;
#X obj 540 900 tabwrite ockm-pat-\$1-acc;
#X obj 710 900 tabwrite ockm-pat-\$1-slide;
#X obj 20 700 mod 16;
#X obj 20 720 tabread \$0-r;
#X obj 20 745 expr \$f1>0 \; \$f1==2 || \$f1==4 \; \$f1>=3;
#X obj 20 780 t f f;
#X obj 20 810 sel 1;
#X obj 400 790 t f f;
#X obj 400 820 expr int(\$f1) % int(\$f2);
#X obj 400 845 tabread \$0-n;
#X obj 400 870 t f f;
#X obj 560 870 expr ((int(\$f1)%7)+7)%7;
#X obj 560 895 tabread \$0-s;
#X obj 400 930 expr \$f2 + 12*floor(\$f1/7) + \$f3;
