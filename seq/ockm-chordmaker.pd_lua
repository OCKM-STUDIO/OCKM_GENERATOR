-- END PRESETS

local SUSTAINED = 11    -- the chord rhythm that hits only where the chord changes
local ONE_CHORD = 0     -- the progression that never changes

-- The progression at a rate, as one chord root per step. PROGRESSIONS[rate + 1][prog + 1] = { root, root, ... }
local function progression(prog, rate)
  local r = PROGRESSIONS[math.max(0, math.min(2, math.floor(rate))) + 1]
  return r and r[math.floor(prog) + 1]
end

-- One step of the pattern: { hit, root }. p: the progression (one root per step), r: the rhythm, i: the step.
-- Push moves every chord change two steps early. A hit that fell on a change moves with it when the two steps before
-- it were empty, so the chord strikes just before the 1 and holds over it; the hit it came from is cleared.
-- Sustained hits once per chord, on the change (and on step 0, unless push moves that hit to the end of the loop).
local function step(p, r, i, push, sustained, one_chord)
  local P, R = #p, #r
  local function pr(k) return p[k % P + 1] end
  local function rr(k) return r[k % R + 1] end
  local sh = push and 2 or 0
  local root = pr(i + sh)
  if sustained then
    local first = (i == 0) and (not push or one_chord)
    return ((first or pr(i + sh) ~= pr(i - 1 + sh)) and 2 or 0), root
  end
  if push and pr(i + 2) ~= pr(i + 1) and rr(i) == 0 and rr(i + 1) == 0 and rr(i + 2) > 0 then
    return rr(i + 2), root   -- the hit two steps on arrives here, with the change
  end
  if push and pr(i) ~= pr(i - 1) and rr(i - 2) == 0 and rr(i - 1) == 0 and rr(i) > 0 then
    return 0, root           -- ...and leaves this step empty
  end
  return rr(i), root
end

-- The whole pattern. Returns two lists (hits, roots), len long. Pure: no Pd in here, so it can be tested on its own.
function cm.pattern(rhythm, prog, rate, push, len)
  local p = progression(prog, rate)
  local r = CHORD_RHYTHMS[math.floor(rhythm) + 1]
  if not p or not r then return nil end
  local on, deg = {}, {}
  local sustained, one_chord = (math.floor(rhythm) == SUSTAINED), (math.floor(prog) == ONE_CHORD)
  for i = 0, len - 1 do on[i + 1], deg[i + 1] = step(p, r, i, push, sustained, one_chord) end
  return on, deg
end

function cm:initialize(sel, atoms)
  self.inlets, self.outlets = 0, 0
  self.track = tostring(atoms[1] or "chord")
  self.v = { rhythm = 0, prog = 0, rate = 1, push = 0, len = 128, mode = 0 }
  self.loading = false
  return true
end

function cm:postinitialize()
  local t = self.track
  self.recv = {}
  -- one method per receive (pdlua calls it with the message's selector and atoms)
  local function on(name, fn)
    local m = "r_" .. #self.recv
    self[m] = function(o, sel, a) fn(tonumber(a[1]) or 0) end
    self.recv[#self.recv + 1] = pd.Receive:new():register(self, name, m)
  end
  for _, k in ipairs({ "rhythm", "prog", "rate", "push" }) do
    on("ockm-" .. t .. "-" .. k, function(x)
      self.v[k] = x
      if not self.loading then self:auto(); self:build(false) end
    end)
  end
  on("ockm-" .. t .. "-gen", function() self:auto(); self:build(false) end)
  on("ockm-" .. t .. "-mode", function(x) self.v.mode = x end)
  on("ockm-loading", function(x) self.loading = (x ~= 0) end)
  on("ockm-" .. t .. "-len", function(x)
    self.v.len = x
    -- on auto, a new length rebuilds to fill it (without stretching it back to the progression's length)
    if not self.loading and not self.fitting and self.v.mode == 0 then self.refit:delay(0) end
  end)
  self.refit = pd.Clock:new():register(self, "refill")
end

function cm:finalize()
  for _, r in ipairs(self.recv or {}) do r:destruct() end
  if self.refit then self.refit:destruct() end
end

function cm:auto() self.v.mode = 0; pd.send("ockm-" .. self.track .. "-mode", "float", { 0 }) end
function cm:refill() if not self.loading and self.v.mode == 0 then self:build(true) end end

-- write the pattern. nofit: keep the length as it is (otherwise the pattern grows or shrinks to the progression's length,
-- never shorter than a bar)
function cm:build(nofit)
  local v, t = self.v, self.track
  local p = progression(v.prog, v.rate)
  if not p then return end
  if not nofit and #p ~= v.len then
    local n = math.max(#p, 16)
    self.fitting = true
    pd.send("ockm-" .. t .. "-fitting", "float", { n })   -- v1.49 the length coming next is the progression's (a following lead keeps 4 bars)
    pd.send("ockm-" .. t .. "-len", "float", { n })
    self.fitting = false
    v.len = n
  end
  local on, deg = cm.pattern(v.rhythm, v.prog, v.rate, v.push > 0, math.floor(v.len))
  if on then
    local ton, tdeg = pd.Table:new():sync("ockm-pat-" .. t .. "-on"), pd.Table:new():sync("ockm-pat-" .. t .. "-deg")
    if ton and tdeg then
      local n = math.min(#on, ton:length(), tdeg:length())
      for i = 1, n do ton:set(i - 1, on[i]); tdeg:set(i - 1, deg[i]) end
      ton:redraw(); tdeg:redraw()
    end
  end
  pd.send("ockm-chord-changed", "bang", {})
end
