#X obj 650 665 t b b;
#X obj 400 690 expr max(0.5\, \$f1/2);
#X obj 400 665 f 2;
#X msg 300 720 stop;
#X obj 100 560 t b b b b;
#X obj 30 472 spigot \$2;
