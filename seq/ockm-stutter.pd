#N canvas 120 120 900 800 12;
#X text 20 10 Rewind and beat repeat on the mix: ockm-rewind (tap) \, ockm-repeat 1/0 (hold). See tools/build.py.;
#X obj 30 50 inlet~;
#X obj 200 80 delwrite~ \$0-ring 20000;
#X obj 120 160 vd~ \$0-ring;
#X obj 30 200 expr~ \$v1*(1-\$v3) + \$v2*\$v3;
#X obj 30 240 outlet~;
#X obj 120 130 vline~;
#X obj 300 160 vline~;
#X msg 300 130 1 6;
#X msg 380 130 0 6;
#X msg 460 130 0;
#X obj 30 300 r ockm-rewind;
#X obj 30 325 t b b b;
#X msg 120 350 0 \, 120 125 \, 500 125 125 \, 4500 1000 250;
#X obj 30 350 delay 1250;
#X obj 30 375 t b b b;
#X msg 30 400 \; ockm-play 1;
#X obj 260 300 r ockm-playing;
#X obj 30 312 spigot 0;
#X obj 30 460 r ockm-repeat;
#X obj 30 485 sel 1 0;
#X obj 200 535 spigot 0;
#X msg 30 510 1;
#X msg 100 510 0;
#X obj 200 510 r ockm-step;
#X obj 200 560 t b b b b;
#X obj 400 560 f 4;
#X msg 400 535 4;
#X obj 520 560 f 0;
#X obj 300 610 expr ockm_stepms*\$f1;
#X obj 300 640 delay;
#X obj 300 665 t b b;
#X obj 520 640 expr \$f1 + ockm_stepms*\$f2;
#X obj 520 665 t f f;
#X obj 650 610 expr ockm_stepms*16;
#X obj 650 640 delay;
#X obj 650 665 t b b;
#X obj 400 690 expr max(0.5\, \$f1/2);
#X obj 400 665 f 4;
#X msg 300 720 stop;
#X obj 100 560 t b b b b;
#X text 300 760 the delay returns to 0 when a repeat starts \, and to the live mix (dry) when it ends;
