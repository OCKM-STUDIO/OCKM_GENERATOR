#N canvas 120 120 900 800 12;
#X text 20 10 Rewind and beat repeat: ockm-rewind (tap) \, ockm-repeat 1/0 (hold). Args: rewind on \, repeat on (the master does rewind \, the drum bus repeat). See tools/build.py.;
#X obj 30 50 inlet~;
#X obj 200 80 delwrite~ \$0-ring 20000;
#X obj 120 160 vd~ \$0-ring;
#X obj 30 200 expr~ \$v1*(1-\$v3) + \$v2*\$v3;
#X obj 30 240 outlet~;
#X obj 120 130 vline~;
#X obj 300 160 vline~;
#X msg 300 130 1 6;
#X msg 380 130 0 6;
#X msg 460 130 0;
#X obj 30 300 r ockm-rewind;
#X obj 30 325 t b b b;
#X msg 120 350 0 \, 80 50 \, 350 50 50 \, 3150 400 100;
#X obj 30 350 delay 500;
#X obj 30 375 t b b b;
#X msg 30 400 \; ockm-play 1;
#X obj 260 300 r ockm-playing;
#X obj 30 312 spigot 0;
