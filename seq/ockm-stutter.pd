#X msg 30 510 1;
#X msg 100 510 0;
#X obj 200 510 r ockm-step;
#X obj 200 560 t b b b b;
#X obj 400 560 f 2;
#X msg 400 535 2;
#X obj 520 560 f 0;
#X obj 300 610 expr ockm_stepms*\$f1;
#X obj 300 640 delay;
#X obj 300 665 t b b;
#X obj 520 640 expr \$f1 + ockm_stepms*\$f2;
#X obj 520 665 t f f;
#X obj 650 610 expr ockm_stepms*8;
