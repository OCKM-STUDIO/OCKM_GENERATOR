#N canvas 120 120 1100 780 12;
#X text 20 10 LFO for the lead: moves one of its four knobs in time with the loop.;
#X obj 20 60 r ockm-lead-k1;
#X obj 20 85 t f f;
#X obj 80 110 v ockm_lead_b1;
#X obj 20 140 expr if(ockm_lead_lt==1 \, min(1 \, max(0 \, \$f1+ockm_lead_mv)) \, \$f1);
#X obj 20 170 s ockm-lead-k1-m;
#X obj 220 60 r ockm-lead-k2;
#X obj 220 85 t f f;
#X obj 280 110 v ockm_lead_b2;
#X obj 220 140 expr if(ockm_lead_lt==2 \, min(1 \, max(0 \, \$f1+ockm_lead_mv)) \, \$f1);
#X obj 220 170 s ockm-lead-k2-m;
#X obj 420 60 r ockm-lead-k3;
