#X obj 20 420 loadbang;
#X obj 20 445 metro 20;
#X obj 20 470 expr fmod(ockm_lead_ph+20/max(1 \, ockm_stepms*pow(2 \, int(ockm_lead_lr))) \, 1) \; ockm_lead_ph;
#X obj 20 500 t f f;
#X obj 100 530 v ockm_lead_ph;
#X obj 220 500 <;
#X obj 220 525 sel 1;
#X obj 220 550 random 2001;
#X obj 220 575 expr \$f1/1000-1;
#X obj 220 600 v ockm_lead_sh;
#X obj 20 560 expr if(int(ockm_lead_ls)==1 \, 4*abs(\$f1-0.5)-1 \, if(int(ockm_lead_ls)==2 \, if(\$f1<0.5 \, 1 \, -1) \, if(int(ockm_lead_ls)==3 \, 2*\$f1-1 \, if(int(ockm_lead_ls)==4 \, ockm_lead_sh \, sin(6.2831853*\$f1)))));
#X obj 20 590 expr \$f1*ockm_lead_ld*0.5;
#X obj 20 620 v ockm_lead_mv;
#X obj 20 650 expr ockm_lead_lt;
#X obj 20 680 sel 1 2 3 4;
#X obj 20 625 expr ockm_lead_ld>0 || ockm_lead_was>0;
