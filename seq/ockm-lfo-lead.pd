#X obj 680 110 v ockm_lead_b4;
#X obj 620 140 expr if(ockm_lead_lt==4 \, min(1 \, max(0 \, \$f1+ockm_lead_mv)) \, \$f1);
#X obj 620 170 s ockm-lead-k4-m;
#X obj 20 230 r ockm-lead-lfo-shape;
