#X obj 20 620 expr if(\$f4>0 && \$s5[(int(\$f1+2)%int(\$f2)+int(\$f2))%int(\$f2)]!=\$s5[(int(\$f1+1)%int(\$f2)+int(\$f2))%int(\$f2)] && \$s6[(int(\$f1)%int(\$f3)+int(\$f3))%int(\$f3)]==0 && \$s6[(int(\$f1+1)%int(\$f3)+int(\$f3))%int(\$f3)]==0 && \$s6[(int(\$f1+2)%int(\$f3)+int(\$f3))%int(\$f3)]>0 \, \$s6[(int(\$f1+2)%int(\$f3)+int(\$f3))%int(\$f3)] \, if(\$f4>0 && \$s5[(int(\$f1)%int(\$f2)+int(\$f2))%int(\$f2)]!=\$s5[(int(\$f1-1)%int(\$f2)+int(\$f2))%int(\$f2)] && \$s6[(int(\$f1-2)%int(\$f3)+int(\$f3))%int(\$f3)]==0 && \$s6[(int(\$f1-1)%int(\$f3)+int(\$f3))%int(\$f3)]==0 && \$s6[(int(\$f1)%int(\$f3)+int(\$f3))%int(\$f3)]>0 \, 0 \, \$s6[(int(\$f1)%int(\$f3)+int(\$f3))%int(\$f3)]));
