#X obj 160 390 list length;
#X obj 100 420 array set \$0-r;
#X obj 360 470 r ockm-\$1-len;
#X obj 300 500 expr if(ockm_cg_nofit \, 0 \, if(\$f1!=\$f2 \, max(\$f1 \, 16) \, 0));
#X obj 300 530 sel 0;
#X obj 340 560 s ockm-\$1-len;
#X msg 120 470 0;
#X obj 20 470 f 128;
#X obj 80 440 r ockm-\$1-len;
#X obj 20 500 until;
#X obj 20 530 f;
#X obj 70 530 + 1;
#X obj 20 560 t f f;
#X obj 20 590 t f f;
#X obj 200 700 tabwrite ockm-pat-\$1-on;
