#N canvas 120 120 900 800 12;
#X text 20 10 Chord generator: a chord rhythm preset plus a progression. Progressions are stored as their natural length in steps plus one chord root per step. If the pattern is shorter than the progression \, it is made longer first. Writes on/accent and chord roots across the whole pattern length.;
#X obj 600 60 array define \$0-r 32;
#X obj 760 60 array define \$0-p 128;
#X obj 20 250 t b b b b;
#X obj 20 225 spigot 1;
#X obj 120 200 r ockm-loading;
#X obj 120 220 == 0;
#X obj 20 100 r ockm-\$1-rhythm;
#X obj 20 130 t b f;
#X obj 20 210 f 0;
#X obj 220 100 r ockm-\$1-prog;
#X obj 220 130 t b f;
#X obj 220 210 f 0;
#X obj 450 100 r ockm-\$1-gen;
#X obj 500 300 text get ockm-presets-progx;
#X obj 500 330 list split 1;
#X obj 500 360 list split 1;
#X obj 500 420 f 16;
#X obj 620 390 array set \$0-p;
#X obj 100 300 text get ockm-presets-chordrhythm;
#X obj 100 330 list split 1;
#X obj 100 360 t l l;
#X obj 160 390 list length;
#X obj 100 420 array set \$0-r;
#X obj 360 470 r ockm-len;
#X obj 300 500 expr if(\$f1>\$f2 \, \$f1 \, 0);
#X obj 300 530 sel 0;
#X obj 340 560 s ockm-length;
#X msg 120 470 0;
#X obj 20 470 f 16;
#X obj 80 440 r ockm-len;
#X obj 20 500 until;
#X obj 20 530 f;
#X obj 70 530 + 1;
#X obj 20 560 t f f;
#X obj 20 590 t f f;
#X obj 200 700 tabwrite ockm-pat-\$1-on;
#X obj 400 700 tabwrite ockm-pat-\$1-deg;
#X obj 300 620 expr int(\$f1) % int(max(\$f2\,1));
#X obj 300 650 tabread \$0-p;
#X obj 20 620 expr int(\$f1) % int(max(\$f2\,1));
#X obj 20 650 tabread \$0-r;
#X text 20 760 hooks: ockm-<track>-rhythm 0-9 \, ockm-<track>-prog 0-9 \, ockm-<track>-gen (rebuild). Presets live in tools/build.py (PRE and PROGS).;
