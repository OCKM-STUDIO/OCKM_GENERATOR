#N canvas 120 120 900 800 12;
#X text 20 10 Chord generator: a chord rhythm preset plus a progression (one chord per bar). Writes on/accent and chord roots across the whole pattern length.;
#X obj 600 60 array define \$0-r 16;
#X obj 760 60 array define \$0-p 8;
#X obj 20 250 t b b b;
#X obj 20 100 r ockm-\$1-rhythm;
#X obj 20 130 t b f;
#X obj 20 210 f 0;
#X obj 220 100 r ockm-\$1-prog;
#X obj 220 130 t b f;
#X obj 220 210 f 0;
#X obj 450 100 r ockm-\$1-gen;
#X obj 300 300 text get ockm-presets-prog;
#X obj 300 330 list split 1;
#X obj 300 360 t l l;
#X obj 360 390 list length;
#X obj 300 420 array set \$0-p;
#X obj 100 300 text get ockm-presets-chordrhythm;
#X obj 100 330 list split 1;
#X obj 100 360 array set \$0-r;
#X msg 120 470 0;
#X obj 20 470 f 16;
#X obj 80 440 r ockm-len;
#X obj 20 500 until;
#X obj 20 530 f;
#X obj 70 530 + 1;
#X obj 20 560 t f f;
#X obj 20 590 t f f;
#X obj 200 700 tabwrite ockm-pat-\$1-on;
#X obj 400 700 tabwrite ockm-pat-\$1-deg;
#X obj 300 620 expr int(\$f1/16) % int(max(\$f2\,1));
#X obj 300 650 tabread \$0-p;
#X obj 20 620 mod 16;
#X obj 20 650 tabread \$0-r;
#X text 20 760 hooks: ockm-<track>-rhythm 0-7 \, ockm-<track>-prog 0-7 \, ockm-<track>-gen (rebuild). Progressions change chord once per 16-step bar \, so use 32 or 64 steps to hear them move.;
#X connect 4 0 5 0;
#X connect 5 1 6 1;
#X connect 5 0 3 0;
#X connect 7 0 8 0;
#X connect 8 1 9 1;
#X connect 8 0 3 0;
#X connect 10 0 3 0;
#X connect 3 2 9 0;
#X connect 9 0 11 0;
#X connect 11 0 12 0;
#X connect 12 1 13 0;
#X connect 13 1 14 0;
#X connect 13 0 15 0;
#X connect 3 1 6 0;
#X connect 6 0 16 0;
#X connect 16 0 17 0;
#X connect 17 1 18 0;
#X connect 3 0 19 0;
#X connect 3 0 20 0;
#X connect 21 0 20 1;
#X connect 19 0 23 1;
#X connect 20 0 22 0;
#X connect 22 0 23 0;
#X connect 23 0 24 0;
#X connect 24 0 23 1;
#X connect 23 0 25 0;
#X connect 25 0 26 0;
#X connect 25 1 27 1;
#X connect 25 1 28 1;
#X connect 26 1 29 0;
#X connect 14 0 29 1;
#X connect 29 0 30 0;
#X connect 30 0 28 0;
#X connect 26 0 31 0;
#X connect 31 0 32 0;
#X connect 32 0 27 0;
