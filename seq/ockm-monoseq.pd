#N canvas 150 150 1800 760 12;
#X text 20 10 Mono synth pattern (bass or lead). Each step has a note \, on/off \, accent and slide. Up to 128 steps.;
#X obj 30 60 inlet;
#X obj 30 100 t f f f f f;
#X obj 30 300 tabread ockm-pat-\$1-note;
#X obj 140 260 tabread ockm-pat-\$1-acc;
#X obj 250 220 tabread ockm-pat-\$1-slide;
#X obj 360 130 sel 0;
#X obj 360 160 f 16;
#X obj 360 185 - 1;
#X obj 420 160 - 1;
#X obj 470 100 r ockm-len;
#X obj 360 210 t f f;
#X obj 360 260 tabread ockm-pat-\$1-slide;
#X obj 470 230 tabread ockm-pat-\$1-on;
#X obj 360 300 *;
#X obj 30 360 pack f f f f;
#X obj 600 140 tabread ockm-pat-\$1-on;
#X obj 30 400 spigot;
#X obj 600 180 == 0;
#X obj 600 210 sel 1;
#X msg 600 240 off;
#X obj 30 460 outlet;
#X obj 30 520 table ockm-pat-\$1-note 128;
#X obj 190 520 table ockm-pat-\$1-on 128;
#X obj 350 520 table ockm-pat-\$1-acc 128;
#X obj 510 520 table ockm-pat-\$1-slide 128;
#X obj 720 120 r ockm-store;
#X obj 720 150 t b f;
#X obj 780 180 * 128;
#X obj 720 320 r ockm-load;
#X obj 780 380 * 128;
#X obj 720 560 r ockm-\$1-edit;
#X obj 720 590 t l l;
#X obj 900 620 list split 1;
#X obj 720 650 unpack f f f f f;
#X obj 1500 120 r ockm-extend;
#X obj 1500 150 unpack f f;
#X obj 1500 210 expr \$f2-\$f1;
#X obj 1500 180 t f f;
#X obj 1500 240 moses 1;
#X obj 1560 270 until;
#X obj 1560 300 f;
#X obj 1610 300 + 1;
#X obj 1560 330 t f f;
#X obj 1560 360 expr \$f1 % \$f2;
#X obj 1560 390 t f f f f;
#X obj 720 220 array get ockm-pat-\$1-note;
#X obj 720 260 array set ockm-bank-\$1-note;
#X obj 720 420 array get ockm-bank-\$1-note 0 128;
#X obj 720 460 array set ockm-pat-\$1-note;
#X obj 720 700 tabwrite ockm-pat-\$1-note;
#X obj 1500 430 tabread ockm-pat-\$1-note;
#X obj 1500 460 tabwrite ockm-pat-\$1-note;
#X obj 910 220 array get ockm-pat-\$1-on;
#X obj 910 260 array set ockm-bank-\$1-on;
