#N canvas 150 150 1500 760 12;
#X text 20 10 Bass pattern. Each step has a note \, on/off \, accent and slide.;
#X obj 30 60 inlet;
#X obj 30 100 t f f f f f;
#X obj 30 300 tabread ockm-pat-\$1-note;
#X obj 140 260 tabread ockm-pat-\$1-acc;
#X obj 250 220 tabread ockm-pat-\$1-slide;
#X obj 360 140 + 15;
#X obj 360 170 mod 16;
#X obj 360 200 t f f;
#X obj 360 260 tabread ockm-pat-\$1-slide;
#X obj 470 230 tabread ockm-pat-\$1-on;
#X obj 360 300 *;
#X obj 30 360 pack f f f f;
#X obj 600 140 tabread ockm-pat-\$1-on;
#X obj 30 400 spigot;
#X obj 600 180 == 0;
#X obj 600 210 sel 1;
#X msg 600 240 off;
#X obj 30 460 outlet;
#X obj 30 520 table ockm-pat-\$1-note 16;
#X obj 190 520 table ockm-pat-\$1-on 16;
#X obj 350 520 table ockm-pat-\$1-acc 16;
#X obj 510 520 table ockm-pat-\$1-slide 16;
#X obj 720 120 r ockm-store;
#X obj 720 150 t b f;
#X obj 780 180 * 16;
#X obj 720 320 r ockm-load;
#X obj 780 380 * 16;
#X obj 720 560 r ockm-bass-edit;
#X obj 720 590 t l l;
#X obj 900 620 list split 1;
#X obj 720 650 unpack f f f f f;
#X obj 720 220 array get ockm-pat-\$1-note;
#X obj 720 260 array set ockm-bank-\$1-note;
#X obj 720 420 array get ockm-bank-\$1-note 0 16;
#X obj 720 460 array set ockm-pat-\$1-note;
#X obj 720 700 tabwrite ockm-pat-\$1-note;
#X obj 910 220 array get ockm-pat-\$1-on;
#X obj 910 260 array set ockm-bank-\$1-on;
#X obj 910 420 array get ockm-bank-\$1-on 0 16;
#X obj 910 460 array set ockm-pat-\$1-on;
#X obj 910 700 tabwrite ockm-pat-\$1-on;
#X obj 1100 220 array get ockm-pat-\$1-acc;
#X obj 1100 260 array set ockm-bank-\$1-acc;
#X obj 1100 420 array get ockm-bank-\$1-acc 0 16;
#X obj 1100 460 array set ockm-pat-\$1-acc;
#X obj 1100 700 tabwrite ockm-pat-\$1-acc;
#X obj 1290 220 array get ockm-pat-\$1-slide;
#X obj 1290 260 array set ockm-bank-\$1-slide;
#X obj 1290 420 array get ockm-bank-\$1-slide 0 16;
#X obj 1290 460 array set ockm-pat-\$1-slide;
#X obj 1290 700 tabwrite ockm-pat-\$1-slide;
#X text 140 400 only lets the note through if the step is on;
#X text 420 100 glide into this note if the previous step had slide on;
#X text 720 530 edit one step: ockm-bass-edit <step> <note> <on> <accent> <slide>;
