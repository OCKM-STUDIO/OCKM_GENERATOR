-- drmz's sequencer and generator (v1.40). Generated by tools/build.py from seq/ockm-drmzseq.lua.in: edit that, not
-- seq/ockm-drmzseq.pd_lua (the grooves are written in from the groovebox's groove list).
--
-- [ockm-drmzseq]   Steps in ockm-pat-z1 .. z8: 0 off, 1 a hit, 2 an accent, between 0 and 1 a softer hit (a ghost).
-- Listens to: ockm-step, ockm-playing, ockm-stepms, ockm-accent (how much quieter a plain hit is than an accent),
--   iz-on (plays while drmz is picked), iz-len (16, 32 or 64), iz-gstyle (which groove), iz-gbusy (0 to 1: extra ghost
--   notes and variations), iz-gen (bang: write the groove), iz-mutate (bang: move a few hits), iz-tap <slot> (play one now),
--   ockm-z<n>-mute (1 silences that voice)
-- Sends iz-hit <slot> <strength> and, with a new groove, ockm-swing.

local dz = pd.Class:new():register("ockm-drmzseq")

local GROOVES = {
  --GROOVES--
}
dz.GROOVES = GROOVES

function dz:initialize()
  self.inlets, self.outlets = 0, 0
  self.on, self.playing, self.len, self.stepms, self.acc = 0, 0, 16, 125, 0.3
  self.style, self.busy = 0, 0.3
  self.mute = {}
  self.seed = os.time() % 100000
  return true
end

function dz:postinitialize()
  self.recv = {}
  local function on(name, fn)
    local m = "r_" .. #self.recv
    self[m] = function(o, sel, at) fn(at or {}) end
    self.recv[#self.recv + 1] = pd.Receive:new():register(self, name, m)
  end
  local num = function(a, d) return tonumber(a[1]) or d end
  on("ockm-step", function(a) self:step(num(a, 0)) end)
  on("ockm-playing", function(a) self.playing = num(a, 0) end)
  on("ockm-stepms", function(a) local m = num(a, 0); if m > 0 then self.stepms = m end end)
  on("ockm-accent", function(a) self.acc = num(a, 0.3) end)
  on("iz-on", function(a) self.on = num(a, 0) end)
  on("iz-len", function(a) local l = math.floor(num(a, 16)); self.len = (l >= 64) and 64 or ((l >= 32) and 32 or 16) end)
  on("iz-gstyle", function(a) self.style = math.floor(num(a, 0)) end)
  on("iz-gbusy", function(a) self.busy = num(a, 0.3) end)
  on("iz-gen", function() self:generate() end)
  on("iz-mutate", function() self:mutate() end)
  on("iz-tap", function(a) local k = math.floor(num(a, 1)); if k >= 1 and k <= 8 then self.taps = self.taps or {}; self.taps[#self.taps + 1] = k; self.tapclock:delay(0) end end)
  for k = 1, 8 do on("ockm-z" .. k .. "-mute", function(a) self.mute[k] = num(a, 0) > 0 end) end
  self.clock = pd.Clock:new():register(self, "late")
  self.tapclock = pd.Clock:new():register(self, "do_taps")
end

function dz:finalize()
  for _, r in ipairs(self.recv or {}) do r:destruct() end
  if self.clock then self.clock:destruct() end
  if self.tapclock then self.tapclock:destruct() end
end

local function tab(name) local t = pd.Table:new(); if t:sync(name) then return t end return nil end
function dz:get(k, i) local t = tab("ockm-pat-z" .. k); if t and i < t:length() then return t:get(i) or 0 end return 0 end
function dz:set(k, i, v) local t = tab("ockm-pat-z" .. k); if t and i < t:length() then t:set(i, v) end end
function dz:redraw() for k = 1, 8 do local t = tab("ockm-pat-z" .. k); if t then t:redraw() end end end

-- a tap from the screen, out of the send that asked for it (a send inside a send trips pdlua up)
function dz:do_taps()
  for _, k in ipairs(self.taps or {}) do pd.send("iz-hit", "list", { k, 1 }) end
  self.taps = {}
  if self.newswing then pd.send("ockm-swing", "float", { self.newswing }); self.newswing = nil end
end

function dz:step(s)
  if self.on <= 0 or self.playing == 0 then return end
  self.pending = math.floor(s) % self.len
  local ms = self.stepms
  if pd.getvalue then ms = tonumber(pd.getvalue("ockm_stepms")) or ms end
  self.clock:delay(ms * 0.25)   -- a quarter step late, like the rest of the engine
end

function dz:late()
  local i = self.pending
  if not i then return end
  for k = 1, 8 do
    local v = self:get(k, i)
    if v > 0 and not self.mute[k] then
      local vel = (v > 1) and 1 or ((v > 0.999) and (1 - self.acc) or v)
      pd.send("iz-hit", "list", { k, vel })
    end
  end
end

function dz:rand() self.seed = (1103515245 * self.seed + 12345) % 2147483648; return self.seed / 2147483648 end

-- the groove, across the whole length; busy adds ghost hats and percussion and varies the later bars a little
function dz:generate()
  local g = GROOVES[(self.style % #GROOVES) + 1]
  if not g then return end
  for k = 1, 8 do
    local row = g.rows[k]
    for i = 0, 63 do
      local v = row[(i % 16) + 1]
      local sound = k - 1
      if v == 0 and (sound == 3 or sound == 4 or sound == 7) and self:rand() < self.busy * 0.25 then v = 0.35 end   -- ghosts: perc and hats
      if i >= 16 and v > 0 and sound ~= 0 and self:rand() < self.busy * 0.12 then v = 0 end                      -- later bars drop the odd hit
      if i >= 16 and v == 0 and sound == 1 and (i % 16) >= 13 and self:rand() < self.busy * 0.3 then v = 0.65 end -- a snare pickup into the next bar
      self:set(k, i, v)
    end
  end
  self:redraw()
  if g.swing and g.swing > 0 then self.newswing = g.swing; self.tapclock:delay(0) end
end

function dz:mutate()
  for k = 2, 8 do
    for i = 0, self.len - 1 do
      if self:rand() < 0.06 then
        local v = self:get(k, i)
        self:set(k, i, (v > 0) and 0 or ((self:rand() < 0.5) and 0.35 or 1))
      end
    end
  end
  self:redraw()
end
