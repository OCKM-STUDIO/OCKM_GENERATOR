#N canvas 120 120 1300 640 12;
#X text 20 10 Recorder. ockm-rec-<name>-open <path> then ockm-rec-<name>-start for mix (stereo) and the stems drums bass lead chord fx (mono). ockm-rec-stop stops them all. 24-bit WAV. Also: ockm-exports-dir on load \, ockm-usb-scan finds USB sticks \, ockm-mkdir <path>.;
#X obj 30 40 r ockm-rec-stop;
#X obj 30 80 r~ ockm-master;
#X obj 30 120 r ockm-rec-mix-open;
#X obj 30 145 list prepend open -bytes 3;
#X obj 30 170 list trim;
#X obj 110 120 r ockm-rec-mix-start;
#X msg 110 145 start;
#X msg 70 195 stop;
#X obj 30 260 writesf~ 2;
#X obj 200 120 r ockm-rec-drums-open;
#X obj 200 145 list prepend open -bytes 3;
#X obj 200 170 list trim;
#X obj 280 120 r ockm-rec-drums-start;
#X msg 280 145 start;
#X msg 240 195 stop;
#X obj 200 260 writesf~ 1;
#X obj 200 230 catch~ ockm-stem-drums;
#X obj 370 120 r ockm-rec-bass-open;
