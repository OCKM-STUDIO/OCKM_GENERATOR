#N canvas 120 120 900 500 12;
#X text 20 10 Transitions (song mode). On a section's last bar: its ending (ockm-end: 1 fill \, 2 riser \, 3 riser + a one-beat gap \, 4 dub out). On a new section's first downbeat: an impact if that pattern has ockm-impact 1.;
#X obj 30 40 r ockm-end;
#X obj 30 65 v ockm_end;
#X obj 150 40 r ockm-impact;
#X obj 150 65 v ockm_impact;
#X obj 30 110 r ockm-song-pos;
#X obj 30 135 unpack f f;
#X obj 30 160 t f f;
#X obj 300 160 f -1;
#X obj 300 185 !=;
#X obj 300 135 t f f;
#X obj 300 210 sel 1;
#X obj 300 235 delay;
#X obj 380 210 expr ockm_stepms*0.25;
#X obj 300 260 expr ockm_impact;
#X obj 300 285 sel 1;
#X msg 300 310 \; ockm-impact-go bang;
#X obj 300 222 t b b;
#X obj 30 210 sel 0;
#X msg 120 235 0;
#X obj 120 260 v ockm_fill_end;
#X obj 30 235 expr ockm_end;
#X obj 30 260 sel 1 2 3 4;
#X msg 30 290 1;
#X obj 30 315 v ockm_fill_end;
#X obj 100 290 expr ockm_stepms*16;
#X obj 100 315 s ockm-riser-go;
#X obj 200 290 expr ockm_stepms*12;
#X obj 200 315 t f f;
#X obj 260 340 s ockm-riser-go;
#X obj 200 365 delay;
#X msg 200 390 \; ockm-gap 1;
#X obj 300 390 expr ockm_stepms*4-6;
#X obj 200 415 delay;
#X msg 200 440 \; ockm-gap 0;
#X obj 450 290 expr ockm_stepms*12;
#X obj 450 315 delay;
#X msg 450 340 \; ockm-delay-throw 1;
#X obj 560 340 expr ockm_stepms*4-6;
#X obj 450 365 delay;
#X msg 450 390 \; ockm-delay-throw 0;
#X obj 600 40 r ockm-playing;
#X obj 600 65 sel 0;
#X msg 600 90 \; ockm-gap 0 \; ockm-delay-throw 0 \; ockm-riser-stop bang;
#X msg 760 90 0;
#X obj 760 115 v ockm_fill_end;
#X msg 600 120 stop;
#X msg 680 120 -1;
