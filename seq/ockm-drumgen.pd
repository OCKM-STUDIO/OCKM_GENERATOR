#N canvas 140 140 700 500 12;
#X text 20 10 One drum slot's share of a groove: picks the 16 steps for the sound this slot plays \, then repeats them across the pattern. Args: slot \, default sound.;
#X obj 500 60 array define \$0-g 16;
#X obj 300 40 loadbang;
#X obj 300 65 f \$2;
#X obj 380 65 r ockm-\$1-sound;
#X obj 300 95 * 16;
#X obj 20 60 r ockm-groove-go;
#X obj 20 90 t b f;
#X obj 120 120 text get ockm-presets-groove;
#X obj 120 150 list split 2;
#X obj 120 180 list split 0;
#X obj 120 210 list split 16;
#X obj 120 240 array set \$0-g;
#X obj 20 270 f 128;
#X obj 80 245 r ockm-drum-len;
#X msg 80 270 0;
#X obj 20 300 until;
#X obj 20 330 f;
#X obj 70 330 + 1;
#X obj 20 360 t f f;
#X obj 20 390 % 16;
#X obj 20 420 tabread \$0-g;
#X obj 20 450 tabwrite ockm-pat-\$1;
#X obj 20 240 t b b;
#X connect 2 0 3 0;
#X connect 3 0 5 0;
#X connect 4 0 5 0;
#X connect 6 0 7 0;
#X connect 7 1 8 0;
#X connect 8 0 9 0;
#X connect 9 1 10 0;
#X connect 5 0 10 1;
#X connect 10 1 11 0;
#X connect 11 0 12 0;
#X connect 7 0 23 0;
#X connect 23 1 15 0;
#X connect 15 0 17 1;
#X connect 23 0 13 0;
#X connect 14 0 13 1;
#X connect 13 0 16 0;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
#X connect 18 0 17 1;
#X connect 17 0 19 0;
#X connect 19 1 22 1;
#X connect 19 0 20 0;
#X connect 20 0 21 0;
#X connect 21 0 22 0;
