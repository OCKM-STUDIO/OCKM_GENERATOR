#N canvas 200 200 760 380 12;
#X text 20 10 Track gate: mute \, solo and level. Gain = (not muted) x (soloed \, or nothing is soloed) x level. Fades over 10 ms so it never clicks.;
#X obj 20 60 inlet~;
#X obj 20 300 *~;
#X obj 20 340 outlet~;
#X obj 200 60 r ockm-\$1-mute;
#X obj 200 85 t b f;
#X obj 200 160 f 0;
#X obj 330 60 r ockm-\$1-solo;
#X obj 330 85 t b f;
#X obj 330 160 f 0;
#X obj 460 60 r ockm-soloing;
#X obj 460 85 t b f;
#X obj 460 160 f 0;
#X obj 590 60 r ockm-\$1-\$2;
#X obj 590 85 t b f;
#X obj 590 160 f 1;
#X obj 200 125 t b b b b;
#X obj 200 200 expr (1-(\$f1!=0)) * if(\$f3>0 \, (\$f2!=0) \, 1) * \$f4;
#X obj 200 230 pack f 10;
#X obj 200 260 line~;
#X obj 560 125 loadbang;
#X connect 4 0 5 0;
#X connect 5 1 6 1;
#X connect 7 0 8 0;
#X connect 8 1 9 1;
#X connect 10 0 11 0;
#X connect 11 1 12 1;
#X connect 13 0 14 0;
#X connect 14 1 15 1;
#X connect 20 0 16 0;
#X connect 5 0 16 0;
#X connect 16 0 6 0;
#X connect 6 0 17 0;
#X connect 8 0 16 0;
#X connect 16 1 9 0;
#X connect 9 0 17 1;
#X connect 11 0 16 0;
#X connect 16 2 12 0;
#X connect 12 0 17 2;
#X connect 14 0 16 0;
#X connect 16 3 15 0;
#X connect 15 0 17 3;
#X connect 17 0 18 0;
#X connect 18 0 19 0;
#X connect 19 0 2 1;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
