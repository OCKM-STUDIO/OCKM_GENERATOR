#N canvas 120 120 700 400 12;
#X text 20 10 Drum grooves: ockm-drum-groove <n> writes a groove into every drum slot \, by the sound each slot plays \, across the whole pattern length. Sets the swing too. Ignored while a pattern loads. Then tells the screens and any part locked to the kick.;
#X obj 20 60 r ockm-drum-groove;
#X obj 20 90 spigot 1;
#X obj 140 60 r ockm-loading;
#X obj 140 85 == 0;
#X obj 20 120 moses 0;
#X obj 60 150 t b b f f;
#X obj 260 190 text get ockm-presets-groove;
#X obj 260 220 list split 1;
#X obj 260 250 list split 1;
#X obj 260 280 moses 1;
#X obj 300 310 s ockm-swing;
#X obj 160 190 s ockm-groove-go;
#X obj 60 340 s ockm-refresh;
#X obj 110 310 s ockm-drums-changed;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X connect 4 0 2 1;
#X connect 2 0 5 0;
#X connect 5 1 6 0;
#X connect 6 3 7 0;
#X connect 7 0 8 0;
#X connect 8 1 9 0;
#X connect 9 0 10 0;
#X connect 10 1 11 0;
#X connect 6 2 12 0;
#X connect 6 1 14 0;
#X connect 6 0 13 0;
