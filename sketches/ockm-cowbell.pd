#N canvas 200 200 1000 430 12;
#X text 20 10 Cowbell (retired from the perc slot in v0.6.1): an 808-style cowbell. Two squared-off tones through a band-pass filter.;
#X obj 30 50 inlet;
#X obj 30 80 * 1;
#X obj 30 110 t f f;
#X obj 30 140 * 0.5;
#X obj 30 170 pack f 250;
#X msg 30 200 \$1 \, 0 \$2;
#X obj 30 230 vline~;
#X obj 250 80 osc~ 540;
#X obj 250 110 *~ 1000;
#X obj 250 140 clip~ -1 1;
#X obj 360 80 osc~ 800;
#X obj 360 110 *~ 1000;
#X obj 360 140 clip~ -1 1;
#X obj 250 175 +~;
#X obj 250 200 *~ 0.5;
#X obj 250 230 bp~ 1500 2;
#X obj 250 270 *~;
#X obj 250 380 outlet~;
#X obj 600 50 r ockm-\$1-tune;
#X obj 770 50 r ockm-\$1-decay;
#X obj 950 50 r ockm-\$1-level;
#X obj 600 80 expr 540*pow(2\,\$f1/12) \; 800*pow(2\,\$f1/12);
#X obj 770 110 * 2.5;
#X text 600 150 tune (semitones) / decay (% \, 100 = normal) / level (0-1);
