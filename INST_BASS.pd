#N canvas 100 100 700 400 12;
#X declare -path voices -path seq;
#X text 20 10 Bass instrument on its own (v1.39): play it from a MIDI keyboard or another sequencer. Settings on ib-<name>. Velocity 100 and up is an accent. ib-note takes note <n> <velocity> or off <n> too.;
#X obj 30 50 notein;
#X obj 30 80 pack f f;
#X obj 30 110 list prepend note;
#X obj 30 135 list trim;
#X obj 30 200 ockm-inst-bass ib;
#X obj 200 170 r ib-note;
#X obj 30 240 clip~ -1 1;
#X obj 30 280 dac~;
#X obj 400 50 declare -path voices -path seq;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 6 0 5 0;
#X connect 5 0 7 0;
#X connect 7 0 8 0;
#X connect 7 0 8 1;
